{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server (port 8081)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server.py",
            "args": ["--port", "8081"],
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Serving on .*(http://localhost:[0-9]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
